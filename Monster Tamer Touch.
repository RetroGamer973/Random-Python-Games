def draw_skull(surf, center, size, color, outline=BLACK):
    cx, cy = center
    r = size * 0.40
    pygame.draw.circle(surf, color, (int(cx), int(cy - size * 0.06)), int(r))
    jaw = pygame.Rect(0, 0, int(r * 1.3), int(r * 0.9))
    jaw.center = (int(cx), int(cy + r * 0.55))
    pygame.draw.rect(surf, color, jaw, border_radius=int(r * 0.25))
    pygame.draw.circle(surf, color, (int(cx), int(cy - size * 0.06)), int(r))
    eye_r = max(2, int(r * 0.26))
    pygame.draw.circle(surf, outline, (int(cx - r * 0.42), int(cy - size * 0.06)), eye_r)
    pygame.draw.circle(surf, outline, (int(cx + r * 0.42), int(cy - size * 0.06)), eye_r)
    nose = [(cx, cy + size * 0.02),
            (cx - r * 0.12, cy + size * 0.18),
            (cx + r * 0.12, cy + size * 0.18)]
    pygame.draw.polygon(surf, outline, nose)
    tooth_w = max(1, int(size * 0.02))
    for i in (-1, 0, 1):
        x = int(cx + i * r * 0.35)
        pygame.draw.line(surf, outline, (x, int(cy + r * 0.35)), (x, int(cy + r * 0.78)), tooth_w)
    pygame.draw.circle(surf, BLACK, (int(cx), int(cy - size * 0.06)), int(r), 2)
    pygame.draw.rect(surf, BLACK, jaw, width=2, border_radius=int(r * 0.25))


def draw_potion(surf, center, size, liquid, outline=BLACK):
    cx, cy = center
    w = size * 0.56
    top = cy - size * 0.28
    bottom = cy + size * 0.36
    neck_w = w * 0.30
    neck = pygame.Rect(0, 0, int(neck_w), int(size * 0.16))
    neck.midbottom = (int(cx), int(top) + 2)
    pygame.draw.rect(surf, liquid, neck)
    pygame.draw.rect(surf, outline, neck, 2)
    cap = pygame.Rect(0, 0, int(neck_w * 1.4), int(size * 0.09))
    cap.midbottom = neck.midtop
    pygame.draw.rect(surf, (150, 120, 90), cap, border_radius=2)
    pygame.draw.rect(surf, outline, cap, width=2, border_radius=2)
    body = [(cx - w / 2, top), (cx + w / 2, top), (cx, bottom)]
    pygame.draw.polygon(surf, liquid, body)
    pygame.draw.polygon(surf, outline, body, 2)
    hi_x = cx - w * 0.16
    pygame.draw.line(surf, WHITE, (int(hi_x), int(top + 6)), (int(cx - w * 0.02), int(bottom - 14)), 2)


def draw_ball(surf, center, size, color, outline=BLACK):
    cx, cy = center
    r = int(size * 0.40)
    pygame.draw.circle(surf, color, center, r)
    pygame.draw.line(surf, outline, (cx - r, cy), (cx + r, cy), 3)
    pygame.draw.circle(surf, outline, center, max(3, int(r * 0.30)))
    pygame.draw.circle(surf, WHITE, center, max(2, int(r * 0.16)))
    pygame.draw.circle(surf, outline, center, r, 2)


def draw_star(surf, center, size, color, outline=BLACK, points=5):
    cx, cy = center
    outer = size * 0.5
    inner = outer * 0.42
    pts = []
    for i in range(points * 2):
        angle = math.pi / points * i - math.pi / 2
        r = outer if i % 2 == 0 else inner
        pts.append((cx + r * math.cos(angle), cy + r * math.sin(angle)))
    pygame.draw.polygon(surf, color, pts)
    pygame.draw.polygon(surf, outline, pts, 2)


