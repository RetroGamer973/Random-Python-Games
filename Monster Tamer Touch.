    def draw_cards(self, area):
        rects = self.card_rects(area, len(self.game.cards))
        for rect, card in zip(rects, self.game.cards):
            if card["type"] == "monster":
                self.draw_monster_card(rect, card)
            elif card["type"] == "potion":
                self.draw_potion_card(rect, card)
            else:
                self.draw_ball_card(rect, card)
            if card.get("resolved"):
                self.draw_resolved_overlay(rect)
            else:
                self.buttons.append(Button(rect, (lambda c=card: self.game.tap_card(c))))

    def draw_pending_overlay(self):
        w, h = self.size()
        g = self.game
        card = g.pending_monster
        catchable = g.catchable(card)
        can_battle = g.active is not None
        can_fight = (not can_battle) and g.has_sword and g.player_hp > 0

        overlay = pygame.Surface((w, h), pygame.SRCALPHA)
        overlay.fill((0, 0, 0, 180))
        self.screen.blit(overlay, (0, 0))
        box = pygame.Rect(0, 0, min(600, int(w * 0.88)), int(h * 0.58))
        box.center = (w // 2, h // 2)
        panel(self.screen, box, radius=18)
        draw_skull(self.screen, (box.centerx, box.y + box.height * 0.16), box.height * 0.2, RED)
        title = self.font_big.render(card["name"], True, TEXT)
        self.screen.blit(title, title.get_rect(center=(box.centerx, box.y + box.height * 0.29)))

        # Monster HP bar.
        bar_w = int(box.width * 0.7)
        mbar = pygame.Rect(0, 0, bar_w, int(box.height * 0.06))
        mbar.center = (box.centerx, box.y + int(box.height * 0.37))
        draw_hp_bar(self.screen, mbar, card["hp"], card["max_hp"])
        mtxt = self.font_tiny.render(f"{card['hp']}/{card['max_hp']} HP", True, MUTED)
        self.screen.blit(mtxt, mtxt.get_rect(center=(box.centerx, mbar.bottom + 12)))

        if not catchable and g.capture_balls <= 0:
            subtitle = "No Capture Balls left - can't catch this one."
        elif catchable and can_battle:
            subtitle = "Catch it, battle it, or flee?"
        elif catchable:
            subtitle = "Catchable now. Battle needs an active monster."
        elif can_battle:
            subtitle = "Capture Level too low to catch - battle or flee?"
        elif can_fight:
            subtitle = "No active monster - fight it yourself, or flee?"
        else:
            subtitle = "Too tough right now - flee is your only option."
        sub = self.font_sm.render(subtitle, True, MUTED)
        self.screen.blit(sub, sub.get_rect(center=(box.centerx, mbar.bottom + 34)))

        actions = []
        if catchable:
            actions.append(("catch", "CATCH", TEAL_DARK, TEAL))
        if can_battle:
            actions.append(("battle", "BATTLE", RED_DARK, RED))
        if can_fight:
            actions.append(("fight", "FIGHT (SWORD)", GOLD_DARK, GOLD))
        actions.append(("flee", "FLEE", FLEE_FILL, PANEL_BORDER_LIT))

        n = len(actions)
        btn_gap = int(box.width * 0.03)
        cols = 2 if n > 2 else n
        rows = (n + cols - 1) // cols
        btn_w = int((box.width - int(box.width * 0.1) - btn_gap * (cols - 1)) / cols)
        btn_h = int(box.height * 0.16)
        start_x = box.x + int(box.width * 0.05)
        by0 = box.bottom - rows * (btn_h + 12) - 10
        for i, (choice, text, fill, border) in enumerate(actions):
            r, c = divmod(i, cols)
            rect = pygame.Rect(start_x + c * (btn_w + btn_gap), by0 + r * (btn_h + 12), btn_w, btn_h)
            pygame.draw.rect(self.screen, fill, rect, border_radius=14)
            pygame.draw.rect(self.screen, border, rect, width=3, border_radius=14)
            t = self.font_mid.render(text, True, WHITE)
            self.screen.blit(t, t.get_rect(center=rect.center))
            self.buttons.append(Button(rect, (lambda ch=choice: self.game.resolve_pending(ch))))

