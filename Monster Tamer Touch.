        self.screen.blit(title, title.get_rect(center=(box.centerx, box.y + box.height * 0.3)))
        sub = self.font_sm.render("Unsaved progress in this run will be lost.", True, MUTED)
        self.screen.blit(sub, sub.get_rect(center=(box.centerx, box.y + box.height * 0.5)))

        btn_w, btn_h = int(box.width * 0.38), int(box.height * 0.28)
        yes_rect = pygame.Rect(box.x + int(box.width * 0.07), box.bottom - btn_h - 20, btn_w, btn_h)
        no_rect = pygame.Rect(box.right - int(box.width * 0.07) - btn_w, box.bottom - btn_h - 20, btn_w, btn_h)

        pygame.draw.rect(self.screen, RED_DARK, yes_rect, border_radius=14)
        pygame.draw.rect(self.screen, RED, yes_rect, width=3, border_radius=14)
        yt = self.font_mid.render("YES, QUIT", True, WHITE)
        self.screen.blit(yt, yt.get_rect(center=yes_rect.center))

        pygame.draw.rect(self.screen, TEAL_DARK, no_rect, border_radius=14)
        pygame.draw.rect(self.screen, TEAL, no_rect, width=3, border_radius=14)
        nt = self.font_mid.render("KEEP PLAYING", True, WHITE)
        self.screen.blit(nt, nt.get_rect(center=no_rect.center))

        self.buttons.append(Button(yes_rect, lambda: sys.exit(0)))
        self.buttons.append(Button(no_rect, self.game.close_quit_confirm))

    def draw(self):
        self.screen.fill(BG)
        self.buttons = []
        if self.game.mode is None:
            self.draw_mode_select()
        elif self.game.mode == "classic_select":
            self.draw_classic_select()
        else:
            status, toast, active_bar, quest_bar, cards_area = self.layout()
            self.draw_status_bar(status)
            self.draw_toast(toast)
            self.draw_active_bar(active_bar)
            if quest_bar:
                self.draw_quest_bar(quest_bar)
            self.draw_cards(cards_area)
            # Each of these overlays is drawn opaque on top of everything
            # above. Without clearing self.buttons first, a tap in the
            # darkened area outside the overlay's own box could still hit
            # a "hidden" button from underneath (e.g. SAVE or a card) that
            # the player can no longer see - clearing keeps taps in sync
            # with what's actually on screen.
            if self.game.show_bench:
                self.buttons = []
                self.draw_bench_overlay()
            elif self.game.show_shop:
                self.buttons = []
                self.draw_shop_overlay()
            elif self.game.pending_monster:
                self.buttons = []
                self.draw_pending_overlay()
            elif self.game.quest_complete:
                self.buttons = []
                self.draw_quest_complete_overlay()
            elif self.game.game_over_msg:
                self.buttons = []
                self.draw_game_over_overlay()
            elif self.game.victory_msg:
                self.buttons = []
                self.draw_victory_overlay()
        # Help is reachable from every screen (mode select, difficulty
        # picker, and gameplay), so it's handled outside the branches
        # above, same as the quit confirmation.
        if self.game.show_help:
            self.buttons = []
            self.draw_help_overlay()
        if self.game.confirm_quit:
            self.buttons = []
            self.draw_quit_confirm_overlay()
        pygame.display.flip()

    def handle_tap(self, pos):
        for btn in reversed(self.buttons):
            if btn.hit(pos):
                btn.on_tap()
                return

    def run(self):
        running = True
        while running:
            # Only the first tap in a frame acts - the button list on
            # screen corresponds to the last draw(), so a second tap
            # event arriving before the next draw() (e.g. a duplicate
            # touch/mouse event for one physical tap) would be acting
            # on stale buttons. Ignoring it until the next frame is
            # redrawn keeps every tap safely in sync with what's shown.
            tapped_this_frame = False
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    running = False
                elif event.type == pygame.VIDEORESIZE:
                    self.screen = pygame.display.set_mode((event.w, event.h), pygame.RESIZABLE)
                    self._build_fonts()
                elif event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_ESCAPE:
                        running = False
                    elif event.key == pygame.K_F11:
                        pygame.display.toggle_fullscreen()
                        self._build_fonts()
                elif event.type == pygame.MOUSEBUTTONDOWN and event.button == 1 and not tapped_this_frame:
                    tapped_this_frame = True
                    self._safe_tap(event.pos)
                elif event.type == pygame.FINGERDOWN and not tapped_this_frame:
                    tapped_this_frame = True
                    w, h = self.size()
                    pos = (int(event.x * w), int(event.y * h))
                    self._safe_tap(pos)
            self.draw()
            self.clock.tick(FPS)
        pygame.quit()

    def _safe_tap(self, pos):
        # A confirmed quit (YES, QUIT) is meant to end the app - let that
        # SystemExit through. Anything else that goes wrong in a tap
        # handler is swallowed so one bad tap can never silently kill
        # the whole game.
        try:
            self.handle_tap(pos)
        except SystemExit:
            raise
        except Exception as exc:
            print(f"Ignored error handling tap: {exc}")


def main():
    try:
        App().run()
    except KeyboardInterrupt:
        pygame.quit()
        sys.exit(0)


if __name__ == "__main__":
    main()
