    def draw_active_bar(self, rect):
        g = self.game
        panel(self.screen, rect, radius=14)
        active = g.active
        icon_r = rect.height * 0.9
        icon_c = (rect.x + rect.height * 0.55, rect.centery)

        if active:
            draw_skull(self.screen, icon_c, icon_r, GREEN_FRIENDLY)
            tx = rect.x + rect.height + 16
            name = self.font_big.render(active["name"], True, TEXT)
            self.screen.blit(name, (tx, rect.y + rect.height * 0.14))
            bar_w = int(rect.width * 0.32)
            bar_rect = pygame.Rect(tx, rect.y + rect.height * 0.6, bar_w, int(rect.height * 0.22))
            draw_hp_bar(self.screen, bar_rect, active["hp"], active["max_hp"])
            hp_txt = self.font_sm.render(f"{active['hp']}/{active['max_hp']} HP", True, MUTED)
            self.screen.blit(hp_txt, (bar_rect.right + 12, bar_rect.centery - hp_txt.get_height() // 2))
        else:
            draw_skull(self.screen, icon_c, icon_r, MUTED)
            tx = rect.x + rect.height + 16
            none_txt = self.font_big.render("No active monster", True, MUTED)
            self.screen.blit(none_txt, (tx, rect.y + rect.height * 0.14))
            if g.no_monster_rounds > 0:
                warn = self.font_sm.render(
                    f"{g.no_monster_rounds} round(s) with none - lose at 2!", True, RED)
                self.screen.blit(warn, (tx, rect.y + rect.height * 0.55))

        right_edge = rect.right - 16
        if g.bench:
            bw, bh = int(rect.height * 1.7), int(rect.height * 0.72)
            brect = pygame.Rect(0, 0, bw, bh)
            brect.midright = (right_edge, rect.centery)
            pygame.draw.rect(self.screen, VIOLET_DARK, brect, border_radius=12)
            pygame.draw.rect(self.screen, VIOLET, brect, width=3, border_radius=12)
            label = self.font_mid.render(f"SWITCH ({len(g.bench)})", True, WHITE)
            self.screen.blit(label, label.get_rect(center=brect.center))
            self.buttons.append(Button(brect, self._open_bench))
            right_edge = brect.left - 12

        if active and g.potions > 0:
            pw, ph = int(rect.height * 1.7), int(rect.height * 0.72)
            prect = pygame.Rect(0, 0, pw, ph)
            prect.midright = (right_edge, rect.centery)
            pygame.draw.rect(self.screen, TEAL_DARK, prect, border_radius=12)
            pygame.draw.rect(self.screen, TEAL, prect, width=3, border_radius=12)
            label = self.font_mid.render(f"POTION ({g.potions})", True, WHITE)
            self.screen.blit(label, label.get_rect(center=prect.center))
            self.buttons.append(Button(prect, self.game.use_potion))

        # Small ownership icons so equipment status is visible at a glance.
        eq_size = rect.height * 0.32
        eq_x = rect.right - eq_size * 0.7
        eq_y = rect.y + eq_size * 0.65
        if g.has_sword:
            draw_sword(self.screen, (eq_x, eq_y), eq_size)
            eq_x -= eq_size * 1.1
        if g.has_shield:
            draw_shield(self.screen, (eq_x, eq_y), eq_size)

    def _open_bench(self):
