def draw_hp_bar(surf, rect, current, maximum, low_color=RED, high_color=GREEN_FRIENDLY):
    """Reusable HP bar - used for both the player and monsters."""
    pygame.draw.rect(surf, PANEL_BORDER, rect, border_radius=8)
    pct = max(0.0, min(1.0, current / maximum)) if maximum else 0.0
    fill_rect = pygame.Rect(rect.x, rect.y, int(rect.width * pct), rect.height)
    color = high_color if pct > 0.4 else low_color
    if fill_rect.width > 0:
        pygame.draw.rect(surf, color, fill_rect, border_radius=8)
    pygame.draw.rect(surf, PANEL_BORDER_LIT, rect, width=2, border_radius=8)


# ---------------------------------------------------------------- #
# Card generation (hp_range/cl_range let modes scale difficulty)
# ---------------------------------------------------------------- #
def gen_monster(hp_range=(4, 18), cl_range=(1, 10)):
    hp = random.randint(*hp_range)
    xp_value = max(1, round(1 + (hp - 4) / 2.8))
    capture_level = random.randint(*cl_range)
    name = random.choice(MONSTER_NAMES)
    return {"type": "monster", "name": name, "hp": hp, "max_hp": hp,
            "capture_level": capture_level, "xp_value": xp_value}


def gen_potion():
    return {"type": "potion", "heal": random.randint(3, 8)}


def gen_ball():
    return {"type": "ball", "boost": random.randint(1, 3)}


def deal_cards(hp_range=(4, 18), cl_range=(1, 10)):
    num_monsters = random.choice([1, 2])
    has_potion = 1 if random.random() < (1 / 3) else 0
    num_balls = 4 - num_monsters - has_potion
    cards = [gen_monster(hp_range, cl_range) for _ in range(num_monsters)]
    if has_potion:
        cards.append(gen_potion())
    cards += [gen_ball() for _ in range(num_balls)]
    random.shuffle(cards)
    for c in cards:
        c["resolved"] = False
    return cards


# ---------------------------------------------------------------- #
# Save file helpers
# ---------------------------------------------------------------- #
def save_exists():
    return os.path.isfile(SAVE_PATH)


def write_save(data):
    try:
        with open(SAVE_PATH, "w") as f:
            json.dump(data, f)
        return True
    except OSError:
        return False


def read_save():
    try:
        with open(SAVE_PATH, "r") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def delete_save():
    try:
        if os.path.isfile(SAVE_PATH):
            os.remove(SAVE_PATH)
    except OSError:
        pass


def save_summary(data):
    mode = data.get("mode")
    if mode == "classic":
        diff = DIFFICULTIES.get(data.get("difficulty"), {}).get("label", "?")
        cap = DIFFICULTIES.get(data.get("difficulty"), {}).get("rounds", "?")
        return f"Classic ({diff}) - Round {data.get('round_num', 1)}/{cap} - XP {data.get('xp', 0)}"
    if mode == "quest":
        qi = data.get("quest_index", 0)
        return f"Quest {qi + 1}/{len(QUESTS)} - XP {data.get('xp', 0)}"
    if mode == "hardcore":
        return f"Hardcore - Round {data.get('round_num', 1)} - XP {data.get('xp', 0)}"
    return "Unknown run"


