    def _build_fonts(self):
        w, h = self.screen.get_size()
        scale = min(w / START_WIDTH, h / START_HEIGHT)
        fam = "couriernew,dejavusansmono,monospace"
        self.font_xl = pygame.font.SysFont(fam, max(16, int(34 * scale)), bold=True)
        self.font_big = pygame.font.SysFont(fam, max(14, int(26 * scale)), bold=True)
        self.font_mid = pygame.font.SysFont(fam, max(12, int(21 * scale)), bold=True)
        self.font_sm = pygame.font.SysFont(fam, max(11, int(17 * scale)))
        self.font_tiny = pygame.font.SysFont(fam, max(10, int(14 * scale)))

    def size(self):
        return self.screen.get_size()

    def layout(self):
        w, h = self.size()
        margin = int(h * 0.02)
        status_h = int(h * 0.11)
        toast_h = int(h * 0.08)
        active_h = int(h * 0.13)
        quest_h = int(h * 0.10) if self.game.mode == "quest" else 0

        status = pygame.Rect(margin, margin, w - 2 * margin, status_h)
        toast = pygame.Rect(margin, status.bottom + margin // 2, w - 2 * margin, toast_h)
        active_bar = pygame.Rect(margin, toast.bottom + margin // 2, w - 2 * margin, active_h)
        if quest_h:
            quest_bar = pygame.Rect(margin, active_bar.bottom + margin // 2, w - 2 * margin, quest_h)
            cards_top = quest_bar.bottom + margin
        else:
            quest_bar = None
            cards_top = active_bar.bottom + margin
        cards = pygame.Rect(margin, cards_top, w - 2 * margin, h - cards_top - margin)
        return status, toast, active_bar, quest_bar, cards

    def card_rects(self, area, n):
        cols = 2
        rows = (n + 1) // 2
        gap = int(area.width * 0.025)
        cw = (area.width - gap * (cols - 1)) // cols
        ch = (area.height - gap * (rows - 1)) // rows
        rects = []
        for i in range(n):
            r, c = divmod(i, cols)
            x = area.x + c * (cw + gap)
            y = area.y + r * (ch + gap)
            rects.append(pygame.Rect(x, y, cw, ch))
        return rects

