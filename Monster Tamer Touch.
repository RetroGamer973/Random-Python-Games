        pygame.draw.rect(self.screen, GOLD, again_rect, border_radius=12)
        at = self.font_mid.render("PLAY AGAIN", True, BLACK)
        self.screen.blit(at, at.get_rect(center=again_rect.center))
        pygame.draw.rect(self.screen, VIOLET_DARK, change_rect, border_radius=12)
        pygame.draw.rect(self.screen, VIOLET, change_rect, width=3, border_radius=12)
        ct = self.font_mid.render("CHANGE MODE", True, WHITE)
        self.screen.blit(ct, ct.get_rect(center=change_rect.center))
        self.buttons.append(Button(again_rect, self.game.play_again))
        self.buttons.append(Button(change_rect, self.game.change_mode))

