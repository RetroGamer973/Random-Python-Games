        draw_coin(self.screen, coin_c, 26, GOLD)
        bal = self.font_big.render(f"{g.credits} credits", True, TEXT)
        self.screen.blit(bal, (coin_c[0] + 20, box.y + 14 + title.get_height() // 2 - bal.get_height() // 2))

        close = pygame.Rect(0, 0, 56, 56)
        close.topright = (box.right - 18, box.y + 16)
        pygame.draw.rect(self.screen, RED_DARK, close, border_radius=12)
        pygame.draw.rect(self.screen, RED, close, width=3, border_radius=12)
        xt = self.font_big.render("X", True, WHITE)
        self.screen.blit(xt, xt.get_rect(center=close.center))
        self.buttons.append(Button(close, self.game.close_shop))

        icon_fns = {"ball": draw_ball, "potion": draw_potion, "sword": draw_sword, "shield": draw_shield}
        icon_colors = {"ball": VIOLET, "potion": TEAL, "sword": (214, 214, 224), "shield": TEAL}

        rows_top = box.y + int(box.height * 0.2)
        row_gap = 16
        row_h = min(110, (box.height - (rows_top - box.y) - 20 - row_gap * len(SHOP_ITEMS)) // len(SHOP_ITEMS))
        y = rows_top
        for item in SHOP_ITEMS:
            row = pygame.Rect(box.x + 20, y, box.width - 40, row_h)
            pygame.draw.rect(self.screen, (24, 27, 40), row, border_radius=12)
            pygame.draw.rect(self.screen, PANEL_BORDER_LIT, row, width=2, border_radius=12)
            icon_fns[item["key"]](self.screen, (row.x + row_h * 0.5, row.centery), row_h * 0.7,
                                   icon_colors[item["key"]])
            tx = row.x + row_h + 10
            label = self.font_big.render(item["label"], True, TEXT)
            self.screen.blit(label, (tx, row.y + row_h * 0.14))
            for j, line in enumerate(wrap_text(item["desc"], self.font_tiny, row.width - row_h - 220)):
                dtxt = self.font_tiny.render(line, True, MUTED)
                self.screen.blit(dtxt, (tx, row.y + row_h * 0.5 + j * 18))

            owned = (item["key"] == "sword" and g.has_sword) or (item["key"] == "shield" and g.has_shield)
            btn_w, btn_h = 150, min(56, int(row_h * 0.6))
            brect = pygame.Rect(0, 0, btn_w, btn_h)
            brect.midright = (row.right - 16, row.centery)
            if owned:
                pygame.draw.rect(self.screen, PANEL_BORDER, brect, border_radius=12)
                bt = self.font_sm.render("OWNED", True, MUTED)
                self.screen.blit(bt, bt.get_rect(center=brect.center))
            else:
                affordable = g.credits >= item["cost"]
                fill = GOLD_DARK if affordable else (40, 40, 46)
                border = GOLD if affordable else PANEL_BORDER
                pygame.draw.rect(self.screen, fill, brect, border_radius=12)
                pygame.draw.rect(self.screen, border, brect, width=3, border_radius=12)
                bt = self.font_sm.render(f"BUY {item['cost']}", True, WHITE if affordable else MUTED)
                self.screen.blit(bt, bt.get_rect(center=brect.center))
                self.buttons.append(Button(brect, (lambda k=item["key"]: self.game.buy_item(k))))
            y += row_h + row_gap

