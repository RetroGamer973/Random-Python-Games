class Button:
    def __init__(self, rect, on_tap):
        self.rect = pygame.Rect(rect)
        self.on_tap = on_tap

    def hit(self, pos):
        return self.rect.collidepoint(pos)


def panel(surf, rect, border=PANEL_BORDER, fill=PANEL, radius=16, width=3):
    pygame.draw.rect(surf, fill, rect, border_radius=radius)
    pygame.draw.rect(surf, border, rect, width=width, border_radius=radius)


def wrap_text(text, font, max_width):
    words = text.split(" ")
    lines, cur = [], ""
    for w in words:
        trial = (cur + " " + w).strip()
        if font.size(trial)[0] <= max_width:
            cur = trial
        else:
            if cur:
                lines.append(cur)
            cur = w
    if cur:
        lines.append(cur)
    return lines


# ---------------------------------------------------------------- #
# Game state / logic
# ---------------------------------------------------------------- #
class Game:
    def __init__(self):
        self.mode = None            # None = top-level mode select
                                     # "classic_select" = difficulty submenu
                                     # "classic" / "quest" / "hardcore" = playing
        self.difficulty = None      # classic mode only: "easy"/"normal"/"hard"
        self._reset_common()
        self.cards = []
        self.last_msg = ("Choose a mode to begin!", GOLD)
        self.pending_monster = None
        self.game_over_msg = None
        self.victory_msg = None
        self.show_bench = False
        self.confirm_quit = False
        self.quest_complete = False
        self.next_quest_title = None
        self.quest_index = 0
        self.quest_progress = {}
        self.show_shop = False
        self.show_help = False

    def _reset_common(self):
        self.xp = 0
        self.capture_level = STARTING_CAPTURE_LEVEL
        self.roster = []
        self.active_index = None
        self.round_num = 1
        self.no_monster_rounds = 0
        self.credits = STARTING_CREDITS
        self.capture_balls = STARTING_CAPTURE_BALLS
        self.potions = 0
        self.has_sword = False
        self.has_shield = False
        self.player_hp = STARTING_PLAYER_HP
        self.player_max_hp = STARTING_PLAYER_HP

    # ---------- mode management ----------
    def go_to_classic_select(self):
        self.mode = "classic_select"

    def back_to_top(self):
        self.mode = None
        self.say("Choose a mode to begin!", GOLD)

    def start_mode(self, mode, difficulty=None):
        self.mode = mode
        self.difficulty = difficulty
        self._reset_common()
        self.game_over_msg = None
        self.victory_msg = None
        self.pending_monster = None
        self.show_bench = False
        self.confirm_quit = False
        self.quest_complete = False
        self.show_shop = False
        self.show_help = False
        if mode == "quest":
            self.quest_index = 0
            self._init_quest_progress()
            self.say(f"{self.current_quest()['title']} - go catch your targets!", GOLD)
        elif mode == "classic":
            d = DIFFICULTIES[difficulty]
            self.say(f"Classic ({d['label']}) - survive {d['rounds']} rounds. Round 1 is catchable!", GOLD)
        else:  # hardcore
            self.say("Hardcore Mode - hard monsters, endless rounds. Round 1 is catchable!", GOLD)
        self.cards = deal_cards(*self.current_ranges())

    def change_mode(self):
        self.mode = None
        self.say("Choose a mode to begin!", GOLD)

    def play_again(self):
        self.start_mode(self.mode, self.difficulty)

    def current_quest(self):
        return QUESTS[self.quest_index]

    def _init_quest_progress(self):
        self.quest_progress = {name: 0 for name in self.current_quest()["targets"]}

    def current_ranges(self):
        if self.mode == "quest":
            q = self.current_quest()
            return q["hp"], q["cl"]
        if self.mode == "classic":
            d = DIFFICULTIES[self.difficulty]
            return d["hp"], d["cl"]
        if self.mode == "hardcore":
            d = DIFFICULTIES["hard"]
            return d["hp"], d["cl"]
        return (4, 18), (1, 10)

    def mode_label(self):
        if self.mode == "classic":
            return f"Classic ({DIFFICULTIES[self.difficulty]['label']})"
        if self.mode == "quest":
            return "Quest"
        if self.mode == "hardcore":
            return "Hardcore"
        return ""

    @property
    def active(self):
        if self.active_index is None or self.active_index >= len(self.roster):
            return None
        return self.roster[self.active_index]

    @property
    def bench(self):
        return [(i, m) for i, m in enumerate(self.roster) if i != self.active_index]

    def cards_remaining(self):
        return sum(1 for c in self.cards if not c.get("resolved"))

    def say(self, msg, color=TEXT):
        self.last_msg = (msg, color)

    def catchable(self, card):
        if self.capture_balls <= 0:
            return False
        return self.round_num == 1 or self.capture_level > card["capture_level"]

    # ---------- save / load ----------
    def to_dict(self):
        return {
            "mode": self.mode,
            "difficulty": self.difficulty,
            "xp": self.xp,
            "capture_level": self.capture_level,
            "roster": self.roster,
            "active_index": self.active_index,
            "round_num": self.round_num,
            "no_monster_rounds": self.no_monster_rounds,
            "quest_index": self.quest_index,
            "quest_progress": self.quest_progress,
            "cards": self.cards,
            "credits": self.credits,
            "capture_balls": self.capture_balls,
            "potions": self.potions,
            "has_sword": self.has_sword,
            "has_shield": self.has_shield,
            "player_hp": self.player_hp,
            "player_max_hp": self.player_max_hp,
        }

    def save(self):
        if self.mode not in ("classic", "quest", "hardcore"):
            return
        ok = write_save(self.to_dict())
        self.say("Game saved!" if ok else "Save failed - couldn't write file.", GOLD if ok else RED)

    def load_from(self, data):
        self.mode = data.get("mode")
        self.difficulty = data.get("difficulty")
        self.xp = data.get("xp", 0)
        self.capture_level = data.get("capture_level", STARTING_CAPTURE_LEVEL)
        self.roster = data.get("roster", [])
        self.active_index = data.get("active_index")
        self.round_num = data.get("round_num", 1)
        self.no_monster_rounds = data.get("no_monster_rounds", 0)
        self.quest_index = data.get("quest_index", 0)
        self.quest_progress = data.get("quest_progress", {})
        self.cards = data.get("cards") or deal_cards(*self.current_ranges())
        for c in self.cards:
            c.setdefault("resolved", False)
        # New-in-this-version fields fall back to sensible defaults so
        # saves from before the shop/HP/equipment update still load.
        self.credits = data.get("credits", STARTING_CREDITS)
        self.capture_balls = data.get("capture_balls", STARTING_CAPTURE_BALLS)
        self.potions = data.get("potions", 0)
        self.has_sword = data.get("has_sword", False)
        self.has_shield = data.get("has_shield", False)
        self.player_max_hp = data.get("player_max_hp", STARTING_PLAYER_HP)
        self.player_hp = data.get("player_hp", self.player_max_hp)
        self.pending_monster = None
        self.game_over_msg = None
        self.victory_msg = None
        self.show_bench = False
        self.confirm_quit = False
        self.quest_complete = False
        self.show_shop = False
        self.say(f"Welcome back! Continuing your {self.mode_label()} run.", GOLD)

    def continue_from_save(self):
        data = read_save()
        if data is None:
            self.say("No save file found.", RED)
            return
        self.load_from(data)

    # ---------- quit confirmation ----------
    def open_quit_confirm(self):
        self.confirm_quit = True

    def close_quit_confirm(self):
        self.confirm_quit = False

    # ---------- actions ----------
    def switch_active(self, idx):
        if 0 <= idx < len(self.roster):
            self.active_index = idx
            self.say(f"{self.roster[idx]['name']} is now active.", TEAL)
        self.show_bench = False

    def catch_monster(self, card):
        if self.capture_balls <= 0:
            self.say("No Capture Balls left - can't catch anything!", RED)
            return
        self.capture_balls -= 1
        self.credits += CREDIT_PER_CATCH
        mon = {"type": "monster", "name": card["name"], "hp": card["hp"],
               "max_hp": card["hp"], "capture_level": card["capture_level"],
               "xp_value": card["xp_value"]}
        self.roster.append(mon)
        if self.active_index is None:
            self.active_index = len(self.roster) - 1
            self.say(f"Caught {mon['name']}! It's now active. (+{CREDIT_PER_CATCH} credits)", TEAL)
        else:
            self.say(f"Caught {mon['name']}! Added to bench. (+{CREDIT_PER_CATCH} credits)", TEAL)
        self._register_quest_catch(card["name"])

    def battle_monster(self, card):
        active = self.active
        if active["hp"] > card["hp"]:
            active["hp"] -= card["hp"]
            self.xp += card["xp_value"]
            self.credits += CREDIT_PER_BATTLE_WIN
            self.say(f"{active['name']} defeats {card['name']}! "
                     f"+{card['xp_value']} XP, +{CREDIT_PER_BATTLE_WIN} credits", TEAL)
            self._apply_hard_battle_damage()
        else:
            self.say(f"{active['name']} was defeated by {card['name']}!", RED)
            del self.roster[self.active_index]
            self.active_index = None
            if self.roster:
                self.active_index = 0
                self.say(f"{self.roster[0]['name']} steps up as active.", GOLD)
                self._apply_hard_battle_damage()
            else:
                self.game_over_msg = f"YOU DIED - final XP: {self.xp}"
                delete_save()

    def sword_fight(self, card):
        """Fight a monster yourself using the sword - no active monster
        needed. Costs player HP based on the monster's toughness."""
        if not self.has_sword:
            return
        dmg = max(1, round(card["hp"] * SWORD_DAMAGE_FRACTION))
        if self.has_shield:
            dmg = max(1, round(dmg * (1 - SHIELD_DAMAGE_REDUCTION)))
        if self.player_hp > dmg:
            self.player_hp -= dmg
            self.xp += card["xp_value"]
            self.credits += CREDIT_PER_BATTLE_WIN
            self.say(f"You strike down {card['name']} with your sword! "
                     f"-{dmg} HP, +{card['xp_value']} XP", TEAL)
            self._apply_hard_battle_damage()
        else:
            self.player_hp = 0
            self.game_over_msg = f"Overwhelmed by {card['name']} - final XP: {self.xp}"
            delete_save()

    def resolve_potion(self, card):
        active = self.active
        if not active:
            self.say("No active monster to heal - potion wasted.", RED)
            return
        before = active["hp"]
        active["hp"] = min(active["max_hp"], active["hp"] + card["heal"])
        self.say(f"{active['name']} heals {active['hp'] - before} HP.", TEAL)

    def resolve_ball(self, card):
        self.capture_level += card["boost"]
        self.capture_balls += 1
        self.say(f"Capture Level +{card['boost']}! Found a Capture Ball "
                 f"(now {self.capture_balls}).", VIOLET)

    def use_potion(self):
        active = self.active
        if self.potions <= 0 or not active:
            return
        if active["hp"] >= active["max_hp"]:
            self.say(f"{active['name']} is already at full HP.", MUTED)
            return
        self.potions -= 1
        before = active["hp"]
        active["hp"] = min(active["max_hp"], active["hp"] + 8)
        self.say(f"Used a Potion - {active['name']} heals {active['hp'] - before} HP.", TEAL)

    def _apply_hard_battle_damage(self):
        """Hard classic and Hardcore drain a little player HP after
        every battle/fight, win or lose."""
        if self.game_over_msg or self.victory_msg:
            return
        is_hard = self.mode == "hardcore" or (self.mode == "classic" and self.difficulty == "hard")
        if not is_hard:
            return
        dmg = random.randint(*HARD_BATTLE_DAMAGE)
        if self.has_shield:
            dmg = max(1, round(dmg * (1 - SHIELD_DAMAGE_REDUCTION)))
        self.player_hp = max(0, self.player_hp - dmg)
        if self.player_hp <= 0:
            self.game_over_msg = f"Your wounds caught up with you - final XP: {self.xp}"
            delete_save()

    # ---------- shop ----------
    def open_shop(self):
        self.show_shop = True

    def close_shop(self):
        self.show_shop = False

    # ---------- help ----------
    def open_help(self):
        self.show_help = True

    def close_help(self):
        self.show_help = False

    def buy_item(self, key):
        item = next((it for it in SHOP_ITEMS if it["key"] == key), None)
        if item is None:
            return
        if key == "sword" and self.has_sword:
            self.say("You already own the Sword.", MUTED)
            return
        if key == "shield" and self.has_shield:
            self.say("You already own the Shield.", MUTED)
            return
        if self.credits < item["cost"]:
            self.say("Not enough credits!", RED)
            return
        self.credits -= item["cost"]
        if key == "ball":
            self.capture_balls += 1
            self.say("Bought a Capture Ball!", VIOLET)
        elif key == "potion":
            self.potions += 1
            self.say("Bought a Potion!", TEAL)
        elif key == "sword":
            self.has_sword = True
            self.say("Bought the Sword! Fight monsters even with no active monster.", GOLD)
        elif key == "shield":
            self.has_shield = True
            self.say("Bought the Shield! Battle damage halved.", GOLD)

    # ---------- quest progression ----------
    def _register_quest_catch(self, name):
        if self.mode != "quest" or self.quest_complete or self.victory_msg:
            return
        targets = self.current_quest()["targets"]
        if name in self.quest_progress and self.quest_progress[name] < targets[name]:
            self.quest_progress[name] += 1
        if all(self.quest_progress[n] >= c for n, c in targets.items()):
            self._complete_quest()

    def _complete_quest(self):
        title = self.current_quest()["title"]
        if self.quest_index + 1 >= len(QUESTS):
            self.victory_msg = f"All quests complete! Final XP: {self.xp}"
            delete_save()
        else:
            self.quest_index += 1
            self._init_quest_progress()
            self.next_quest_title = self.current_quest()["title"]
            self.quest_complete = True
            self.say(f"{title} complete!", GOLD)

    def continue_after_quest(self):
        self.quest_complete = False
        self.round_num += 1
        self.cards = deal_cards(*self.current_ranges())
        self.say(f"{self.next_quest_title} - go catch your targets!", GOLD)

    # ---------- turn flow: tap through all 4 cards, then auto-redeal ----------
    def tap_card(self, card):
        if (self.game_over_msg or self.victory_msg or self.pending_monster
                or self.show_bench or self.confirm_quit or self.quest_complete
                or self.show_shop or self.show_help):
            return
        if card.get("resolved"):
            return
        if card["type"] == "monster":
            self.pending_monster = card
            return  # resolved via resolve_pending once the player picks an action
        elif card["type"] == "potion":
            self.resolve_potion(card)
        elif card["type"] == "ball":
            self.resolve_ball(card)
        card["resolved"] = True
        self._finish_card_if_round_done()

    def resolve_pending(self, choice):
        card = self.pending_monster
        if card is None:
            # Defensive: a duplicate/phantom tap landed here after the
            # popup already closed. Ignore it instead of crashing.
            return
        self.pending_monster = None
        if choice == "catch":
            self.catch_monster(card)
        elif choice == "battle":
            self.battle_monster(card)
        elif choice == "fight":
            self.sword_fight(card)
        elif choice == "flee":
            self.say(f"You flee from {card['name']}.", MUTED)
        card["resolved"] = True
        self._finish_card_if_round_done()

    def _finish_card_if_round_done(self):
        if self.game_over_msg or self.victory_msg or self.quest_complete:
            return
        if self.cards_remaining() == 0:
            self._advance_round()

    def _advance_round(self):
        self.round_num += 1
        if self.mode == "classic":
            cap = DIFFICULTIES[self.difficulty]["rounds"]
            if self.round_num > cap:
                label = DIFFICULTIES[self.difficulty]["label"]
                self.victory_msg = f"You survived all {cap} rounds ({label})! Final XP: {self.xp}"
                delete_save()
                return
        if self.active is None:
            self.no_monster_rounds += 1
            if self.no_monster_rounds >= 2:
                self.game_over_msg = (f"No monster for {self.no_monster_rounds} rounds - "
                                        f"you lose! Final XP: {self.xp}")
                delete_save()
                return
        else:
            self.no_monster_rounds = 0
        self.cards = deal_cards(*self.current_ranges())


