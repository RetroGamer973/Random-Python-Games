    def _draw_again_change_buttons(self, box):
        btn_w, btn_h = int(box.width * 0.42), int(box.height * 0.2)
        again_rect = pygame.Rect(box.x + int(box.width * 0.05), box.bottom - btn_h - 20, btn_w, btn_h)
